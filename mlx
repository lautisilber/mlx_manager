#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
SCRIPT_NAME="mlx"
VENV_DIR="$HOME/.mlx-manager/venv"
RUNTIME_VENV_DIR="$HOME/.mlx-manager/venv-runtime"
COMMANDS=(create-venv delete-venv get list chat serve delete completion)

if [ -n "${HF_HUB_CACHE:-}" ]; then
  HF_CACHE_DIR="$HF_HUB_CACHE"
elif [ -n "${HF_HOME:-}" ]; then
  HF_CACHE_DIR="$HF_HOME/hub"
else
  HF_CACHE_DIR="$HOME/.cache/huggingface/hub"
fi

usage() {
  cat <<EOF
Usage: $SCRIPT_NAME <command> [arguments]

Commands:
  create-venv                    Create the python venv used to run mlx-lm (optional; created automatically on first use)
  delete-venv [-y]               Delete the mlx-lm venv(s) (see below)
  get <huggingface-name>         Download a model from huggingface
  list                           List all installed models
  chat <huggingface-name>        Chat with an installed model
  serve <huggingface-name> [--port <port>] [--host <host>]  Serve a model (defaults: port 8080, host 127.0.0.1)
  delete <huggingface-name> [-y] Delete an installed model
  completion                     Print shell completion code (see below)

Tab completion is optional. To enable it, add this to your shell's rc file:
  source <(mlx completion)
It auto-detects bash vs zsh and does nothing unless you add that line.
EOF
}

create_main_venv() {
  echo "Creating venv at $VENV_DIR..."
  mkdir -p "$(dirname "$VENV_DIR")"
  python3 -m venv "$VENV_DIR"
  "$VENV_DIR/bin/pip" install --upgrade pip
  "$VENV_DIR/bin/pip" install mlx-lm
  echo "Done. mlx-lm installed."
}

# lazily created on first use, then reused for every normal model, mirroring
# how ensure_runtime_venv works for custom-runtime packs
ensure_venv() {
  if [ ! -d "$VENV_DIR" ]; then
    create_main_venv
  fi
}

run_in_venv() {
  local venv_dir="$1" exe="$2"; shift 2
  if [ ! -d "$venv_dir" ]; then
    echo "venv not found at $venv_dir." >&2
    exit 1
  fi
  "$venv_dir/bin/$exe" "$@"
}

# custom-runtime packs (see pack_requires_runtime) get their own venv, lazily
# created on first use, so installing their pinned deps never disturbs the
# main venv that every other model uses
ensure_runtime_venv() {
  if [ ! -d "$RUNTIME_VENV_DIR" ]; then
    echo "Creating a separate venv for custom-runtime packs at $RUNTIME_VENV_DIR..."
    python3 -m venv "$RUNTIME_VENV_DIR"
    "$RUNTIME_VENV_DIR/bin/pip" install --upgrade pip
  fi
}

confirm() {
  local prompt="$1"
  read -r -p "$prompt [y/N] " reply
  case "$reply" in
    [yY]|[yY][eE][sS]) return 0 ;;
    *) return 1 ;;
  esac
}

model_to_dir_name() {
  echo "models--$(printf '%s' "$1" | sed 's#/#--#g')"
}

model_installed() {
  [ -d "$HF_CACHE_DIR/$(model_to_dir_name "$1")" ]
}

model_snapshot_dir() {
  local snap
  for snap in "$HF_CACHE_DIR/$(model_to_dir_name "$1")/snapshots"/*; do
    [ -d "$snap" ] && { echo "$snap"; return 0; }
  done
  return 1
}

# some packs (e.g. custom quantization schemes) declare an architecture mlx-lm
# doesn't know and ship their own loader in runtime/; config.json says so via requires_runtime
pack_requires_runtime() {
  [ -f "$1/config.json" ] || return 1
  python3 -c "
import json, sys
with open(sys.argv[1]) as f:
    sys.exit(0 if json.load(f).get('requires_runtime') else 1)
" "$1/config.json"
}

# if $1 is a custom-runtime pack, ensures the runtime venv + its pinned deps
# are ready and prints the snapshot dir (for the caller to route to
# pack_chat.py/pack_serve.py instead of mlx_lm); returns 1 otherwise.
# pip/venv-creation output is redirected to stderr so it doesn't end up in
# the captured snapshot-dir value.
prepare_runtime_pack() {
  local snap
  snap="$(model_snapshot_dir "$1")" || return 1
  pack_requires_runtime "$snap" || return 1
  echo "This pack declares a custom runtime loader; using the separate runtime venv..." >&2
  ensure_runtime_venv 1>&2
  if [ -f "$snap/runtime/requirements.txt" ]; then
    run_in_venv "$RUNTIME_VENV_DIR" pip install -r "$snap/runtime/requirements.txt" 1>&2
  fi
  echo "$snap"
}

hf_download_exe() {
  if [ -x "$VENV_DIR/bin/hf" ]; then
    echo "hf"
  else
    echo "huggingface-cli"
  fi
}

cmd_create_venv() {
  if [ -d "$VENV_DIR" ]; then
    echo "venv already exists at $VENV_DIR."
    return 0
  fi
  create_main_venv
}

cmd_delete_venv() {
  local yes=0
  for arg in "$@"; do
    case "$arg" in -y|--yes) yes=1 ;; esac
  done

  local -a existing=()
  [ -d "$VENV_DIR" ] && existing+=("$VENV_DIR")
  [ -d "$RUNTIME_VENV_DIR" ] && existing+=("$RUNTIME_VENV_DIR")

  if [ "${#existing[@]}" -eq 0 ]; then
    echo "No mlx venvs found."
    return 0
  fi

  if [ "$yes" -ne 1 ]; then
    echo "Delete the following venvs?"
    printf '  %s\n' "${existing[@]}"
    if ! confirm "Proceed?"; then
      echo "Aborted."
      return 0
    fi
  fi

  rm -rf "${existing[@]}"
  echo "Deleted:"
  printf '  %s\n' "${existing[@]}"
}

cmd_get() {
  local model="${1:-}"
  if [ -z "$model" ]; then
    echo "Usage: $SCRIPT_NAME get <huggingface-name>" >&2
    exit 1
  fi
  ensure_venv
  echo "Downloading $model..."
  run_in_venv "$VENV_DIR" "$(hf_download_exe)" download "$model"
}

list_model_names() {
  local dir name
  for dir in "$HF_CACHE_DIR"/models--*; do
    [ -d "$dir" ] || continue
    name="$(basename "$dir")"
    name="${name#models--}"
    echo "${name//--//}"
  done
}

cmd_list() {
  local names
  names="$(list_model_names)"
  if [ -z "$names" ]; then
    echo "No models installed."
  else
    printf '%s\n' "$names"
  fi
}

cmd_chat() {
  local model="${1:-}"
  if [ -z "$model" ]; then
    echo "Usage: $SCRIPT_NAME chat <huggingface-name>" >&2
    exit 1
  fi
  if ! model_installed "$model"; then
    echo "Model '$model' is not installed. Run '$SCRIPT_NAME get $model' first." >&2
    exit 1
  fi

  local snap
  if snap="$(prepare_runtime_pack "$model")"; then
    run_in_venv "$RUNTIME_VENV_DIR" python3 "$SCRIPT_DIR/mlx_manager/pack_chat.py" "$snap"
    return
  fi

  ensure_venv
  run_in_venv "$VENV_DIR" mlx_lm.chat --model "$model"
}

cmd_serve() {
  local model="" port="8080" host="127.0.0.1"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --port) port="$2"; shift 2 ;;
      --host) host="$2"; shift 2 ;;
      *) model="$1"; shift ;;
    esac
  done
  if [ -z "$model" ]; then
    echo "Usage: $SCRIPT_NAME serve <huggingface-name> [--port <port>] [--host <host>]" >&2
    exit 1
  fi
  if ! model_installed "$model"; then
    echo "Model '$model' is not installed. Run '$SCRIPT_NAME get $model' first." >&2
    exit 1
  fi

  local snap
  if snap="$(prepare_runtime_pack "$model")"; then
    echo "Serving $model on $host:$port..."
    run_in_venv "$RUNTIME_VENV_DIR" python3 "$SCRIPT_DIR/mlx_manager/pack_serve.py" "$snap" "$port" "$model" "$host"
    return
  fi

  ensure_venv
  run_in_venv "$VENV_DIR" mlx_lm.server --model "$model" --port "$port" --host "$host"
}

cmd_delete() {
  local model="" yes=0
  for arg in "$@"; do
    case "$arg" in
      -y|--yes) yes=1 ;;
      *) model="$arg" ;;
    esac
  done
  if [ -z "$model" ]; then
    echo "Usage: $SCRIPT_NAME delete <huggingface-name> [-y]" >&2
    exit 1
  fi
  if ! model_installed "$model"; then
    echo "Model '$model' is not installed." >&2
    exit 1
  fi
  if [ "$yes" -ne 1 ] && ! confirm "Delete model '$model'? This cannot be undone."; then
    echo "Aborted."
    return 0
  fi
  rm -rf "$HF_CACHE_DIR/$(model_to_dir_name "$model")"
  echo "Deleted $model."
}

cmd_complete() {
  local line point cur cword
  line="${COMP_LINE:-}"
  point="${COMP_POINT:-${#line}}"
  line="${line:0:point}"

  # intentionally unquoted: splits on whitespace like COMP_WORDS would
  local -a words=( $line )
  if [[ "$line" == *[[:space:]] ]]; then
    words+=("")
  fi
  cword=$(( ${#words[@]} - 1 ))
  [ "$cword" -lt 0 ] && cword=0
  cur="${words[cword]:-}"

  if [ "$cword" -le 1 ]; then
    compgen -W "${COMMANDS[*]}" -- "$cur"
    return
  fi

  case "${words[1]:-}" in
    chat|serve|delete)
      if [ "$cword" -eq 2 ]; then
        compgen -W "$(list_model_names)" -- "$cur"
      fi
      ;;
  esac
}

cmd_completion() {
  cat <<'EOF'
if [ -n "${ZSH_VERSION:-}" ]; then
  type compdef >/dev/null 2>&1 || { autoload -Uz compinit; compinit -u; }
  type complete >/dev/null 2>&1 || { autoload -Uz bashcompinit; bashcompinit; }
  complete -C 'mlx __complete' mlx
elif [ -n "${BASH_VERSION:-}" ]; then
  complete -C 'mlx __complete' mlx
else
  echo "mlx completion: unsupported shell (only bash and zsh are supported)" >&2
fi
EOF
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    create-venv) shift; cmd_create_venv "$@" ;;
    delete-venv) shift; cmd_delete_venv "$@" ;;
    get) shift; cmd_get "$@" ;;
    list) shift; cmd_list "$@" ;;
    chat) shift; cmd_chat "$@" ;;
    serve) shift; cmd_serve "$@" ;;
    delete) shift; cmd_delete "$@" ;;
    completion) shift; cmd_completion "$@" ;;
    __complete) cmd_complete ;;
    -h|--help|help|"") usage ;;
    *)
      echo "Unknown command: $cmd" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
